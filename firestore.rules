rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return hasUserProfile() && myProfile().active != false;
    }

    function myRole() {
      return myProfile().role;
    }

    function isManager() {
      return myRole() in ['shop_manager', 'production_manager'];
    }

    function canEditRO() {
      return myRole() in ['shop_manager', 'production_manager', 'estimator'];
    }

    function isLimitedShopRole() {
      return myRole() in ['body_man', 'painter', 'paint_helper', 'parts_manager'];
    }

    function isConversationMember(conversationId) {
      return isActive()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    match /users/{uid} {
      allow get: if isAuth() && (request.auth.uid == uid || isActive());
      allow list: if isActive();

      allow create: if isActive() && isManager();
      allow update: if isActive() && (
        isManager() ||
        (
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'updatedAt'])
        )
      );
      allow delete: if isActive() && isManager();
    }

    match /ros/{roId} {
      allow read: if isActive();
      allow create: if isActive() && canEditRO();
      allow update: if isActive() && (
        canEditRO() ||
        (
          isLimitedShopRole() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'partsStatus', 'notes', 'updatedAt'])
        )
      );
      allow delete: if isActive() && isManager();
    }

    match /tasks/{taskId} {
      allow read: if isActive();
      allow create: if isActive() && isManager();
      allow update: if isActive() && (
        isManager() ||
        (
          request.auth.uid == resource.data.assignedTo &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'completedAt', 'updatedAt'])
        )
      );
      allow delete: if isActive() && isManager();
    }

    match /conversations/{conversationId} {
      allow read: if isActive() && request.auth.uid in resource.data.members;
      allow create: if isActive()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.keys().hasOnly([
          'type', 'members', 'dmKey', 'name', 'lastMessage', 'lastAt', 'createdAt'
        ]);
      allow update: if isActive()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'lastMessage', 'lastAt', 'updatedAt']);
      allow delete: if isActive() && isManager();

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'createdAt'
          ]);
        allow update, delete: if false;
      }
    }

    match /settings/{docId} {
      allow read, write: if isActive() && isManager();
    }
  }
}
