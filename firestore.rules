rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester logged in?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: fetch the caller's role from Firestore
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isManager() {
      return myRole() in ['shop_manager', 'production_manager'];
    }

    function canEditRO() {
      return myRole() in ['shop_manager', 'production_manager', 'estimator'];
    }

    // ── Users collection ──────────────────────────────────────────────────────
    match /users/{uid} {
      // Anyone logged in can read user profiles (needed for name lookups)
      allow read: if isAuth();
      // Managers can manage user profiles
      allow write: if isAuth() && isManager();
      // First phone-login profile can be created by that same user only as a basic employee
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == 'body_man';
      // Users can update their own personal preferences only, not role/access fields
      allow update: if isAuth() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'language', 'updatedAt']);
    }

    // ── Repair Orders ─────────────────────────────────────────────────────────
    match /ros/{roId} {
      // All logged-in employees can read ROs
      allow read: if isAuth();
      // Only estimators / managers can create new ROs
      allow create: if isAuth() && canEditRO();
      // Any logged-in employee can update existing ROs through the app/GIB flow.
      allow update: if isAuth();
      allow delete: if isAuth() && isManager();
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuth();
      // Any logged-in employee can create tasks through the app/GIB flow.
      allow create: if isAuth();
      // Managers can update anything; assignees can update status and add notes
      allow update: if isAuth() && (
        isManager() ||
        (request.auth.uid == resource.data.assignedTo &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'completedAt', 'updatedAt', 'taskNotes']))
      );
      allow delete: if isAuth() && isManager();
    }

    // ── Chat conversations ────────────────────────────────────────────────────
    match /conversations/{convoId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;
      allow update: if isAuth() && request.auth.uid in resource.data.members && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastAt', 'lastSenderId', 'lastSenderName'])
          && request.resource.data.lastSenderId == request.auth.uid
        )
      );
      allow delete: if isAuth() && isManager();

      match /messages/{messageId} {
        allow read: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.members;
        allow create: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.members
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Settings (AI key, mappings) ───────────────────────────────────────────
    match /settings/{docId} {
      // All employees can read settings (needed for AI key access)
      // Only managers can write settings
      allow read: if isAuth();
      allow write: if isAuth() && isManager();
    }
  }
}
