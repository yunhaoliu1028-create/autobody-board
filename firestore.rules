rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester logged in?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: fetch the caller's role from Firestore
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isManager() {
      return myRole() in ['shop_manager', 'production_manager', 'estimator'];
    }

    function canEditRO() {
      return myRole() in ['shop_manager', 'production_manager', 'estimator'];
    }

    function hasValidGibRevisionTransition() {
      let before = resource.data.get('gibRevision', 0);
      let after = request.resource.data.get('gibRevision', 0);
      return after is int
        && after >= 0
        && (
          (before is int && after == before + 1)
          || (!(before is int) && after == 1)
        );
    }

    function hasValidTaskRevisionTransition() {
      let before = resource.data.get('taskRevision', 0);
      let after = request.resource.data.get('taskRevision', 0);
      return after is int
        && after >= 0
        && (
          (before is int && after == before + 1)
          || (!(before is int) && after == 1)
        );
    }

    function hasCurrentTaskDeleteReceipt(taskId) {
      let receiptPath = /databases/$(database)/documents/taskDeletionReceipts/$(taskId);
      return existsAfter(receiptPath)
        && getAfter(receiptPath).data.kind == 'task_delete'
        && getAfter(receiptPath).data.taskId == taskId
        && getAfter(receiptPath).data.actorUid == request.auth.uid
        && getAfter(receiptPath).data.expectedTaskRevision
          == resource.data.get('taskRevision', 0)
        && getAfter(receiptPath).data.committedAt == request.time;
    }

    function hasCurrentGibUndoReceipt(taskId) {
      let ownerUid = resource.data.get('gibOperationOwnerUid', '_missing_owner_');
      let operationId = resource.data.get('gibOperationId', '_missing_operation_');
      let operationPath = /databases/$(database)/documents/gibOperations/$(ownerUid)/operations/$(operationId);
      let operation = get(operationPath).data;
      let headPath = /databases/$(database)/documents/gibUndoHeads/$(ownerUid)/surfaces/$(operation.surfaceId);
      let receiptPath = /databases/$(database)/documents/gibOperations/$(ownerUid)/operations/$(operationId)/undoReceipts/undo_v1;
      return ownerUid == request.auth.uid
        && operationId is string
        && resource.data.get('taskRevision', -1) == 0
        && resource.data.get('status', '') == 'pending'
        && exists(operationPath)
        && isManager()
        && exists(headPath)
        && get(headPath).data.operationId == operationId
        && get(headPath).data.manifestHash == operation.undoManifestHash
        && !existsAfter(headPath)
        && existsAfter(receiptPath)
        && getAfter(receiptPath).data.kind == 'gib_undo'
        && getAfter(receiptPath).data.ownerUid == request.auth.uid
        && getAfter(receiptPath).data.operationId == operationId
        && getAfter(receiptPath).data.createdTaskIds == operation.createdTaskIds
        && taskId in getAfter(receiptPath).data.createdTaskIds
        && getAfter(receiptPath).data.committedAt == request.time;
    }

    function canCommitGibUndoReceipt(uid, operationId) {
      let operationPath = /databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId);
      let operation = get(operationPath).data;
      let headPath = /databases/$(database)/documents/gibUndoHeads/$(uid)/surfaces/$(operation.surfaceId);
      return exists(operationPath)
        && operation.ownerUid == uid
        && (
          isManager()
          || (
            operation.updatedTaskIds.size() == 0
            && operation.createdTaskIds.size() == 0
          )
        )
        && exists(headPath)
        && get(headPath).data.kind == 'gib_undo_head'
        && get(headPath).data.ownerUid == uid
        && get(headPath).data.operationId == operationId
        && get(headPath).data.manifestHash == operation.undoManifestHash
        && get(headPath).data.itemCount == operation.undoItemCount
        && !existsAfter(headPath);
    }

    // ── Users collection ──────────────────────────────────────────────────────
    match /users/{uid} {
      // Anyone logged in can read user profiles (needed for name lookups)
      allow read: if isAuth();
      // Managers can manage user profiles
      allow write: if isAuth() && isManager();
      // First phone-login profile can be created by that same user only as a basic employee
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == 'body_man';
      // Users can update their own personal preferences only, not role/access fields
      allow update: if isAuth() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'language', 'updatedAt']);
    }

    // ── Repair Orders ─────────────────────────────────────────────────────────
    match /ros/{roId} {
      // All logged-in employees can read ROs
      allow read: if isAuth();
      // Only estimators / managers can create new ROs
      allow create: if isAuth()
        && canEditRO()
        && request.resource.data.gibRevision == 0;
      // Any logged-in employee can update existing ROs through the app/GIB flow.
      allow update: if isAuth() && hasValidGibRevisionTransition();
      allow delete: if isAuth() && isManager();
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuth();
      // Any logged-in employee can create tasks through the app/GIB flow.
      allow create: if isAuth()
        && request.resource.data.taskRevision == 0;
      // Managers can update anything; assignees can update status and add notes
      allow update: if isAuth() && hasValidTaskRevisionTransition() && (
        isManager() ||
        (request.auth.uid == resource.data.assignedTo &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'startedAt', 'completedAt', 'updatedAt', 'taskNotes', 'taskRevision']))
      );
      allow delete: if isAuth() && (
        hasCurrentGibUndoReceipt(taskId)
        || (isManager() && hasCurrentTaskDeleteReceipt(taskId))
      );
    }

    match /taskDeletionReceipts/{taskId} {
      allow read: if false;
      allow create, update: if isAuth()
        && isManager()
        && request.resource.data.keys().hasAll([
          'kind', 'taskId', 'actorUid', 'expectedTaskRevision', 'committedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'kind', 'taskId', 'actorUid', 'expectedTaskRevision', 'committedAt'
        ])
        && request.resource.data.kind == 'task_delete'
        && request.resource.data.taskId == taskId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.expectedTaskRevision is int
        && request.resource.data.expectedTaskRevision >= 0
        && request.resource.data.committedAt == request.time;
      allow delete: if false;
    }

    // ── Immutable GIB operation ledger ──────────────────────────────────────
    // This create-only sentinel is committed in the same atomic batch as the
    // RO/task changes. A repeated operation ID therefore makes the entire
    // duplicate batch fail instead of applying notes/parts/tasks twice.
    match /gibOperations/{uid}/operations/{operationId} {
      allow get: if isAuth() && (request.auth.uid == uid || isManager());
      allow list: if false;
      allow create: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'kind', 'operationId', 'ownerUid', 'planFingerprint',
          'schemaVersion', 'sourceRole', 'actionCount', 'writeCount',
          'surface', 'surfaceId', 'summary', 'targetRoIds',
          'createdTaskIds', 'updatedTaskIds', 'baseRoRevisions',
          'resultRoRevisions', 'undoSchemaVersion', 'undoManifestHash',
          'undoManifestBytes', 'undoItemCount', 'committedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'kind', 'operationId', 'ownerUid', 'planFingerprint',
          'schemaVersion', 'sourceRole', 'actionCount', 'writeCount',
          'surface', 'surfaceId', 'summary', 'targetRoIds',
          'createdTaskIds', 'updatedTaskIds', 'baseRoRevisions',
          'resultRoRevisions', 'undoSchemaVersion', 'undoManifestHash',
          'undoManifestBytes', 'undoItemCount', 'committedAt'
        ])
        && request.resource.data.kind == 'gib_apply'
        && request.resource.data.operationId == operationId
        && request.resource.data.operationId is string
        && request.resource.data.operationId.size() >= 30
        && request.resource.data.operationId.size() <= 120
        && request.resource.data.ownerUid == uid
        && request.resource.data.planFingerprint is string
        && request.resource.data.planFingerprint.matches('^[0-9a-f]{64}$')
        && request.resource.data.schemaVersion == 3
        && request.resource.data.sourceRole is string
        && request.resource.data.sourceRole.size() <= 64
        && request.resource.data.actionCount is int
        && request.resource.data.actionCount >= 1
        && request.resource.data.actionCount <= 449
        && request.resource.data.writeCount is int
        && request.resource.data.writeCount >= 4
        && request.resource.data.writeCount <= 450
        && request.resource.data.surface is string
        && request.resource.data.surface.size() >= 1
        && request.resource.data.surface.size() <= 160
        && request.resource.data.surfaceId is string
        && request.resource.data.surfaceId.matches('^surface_[0-9a-f]{64}$')
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 1200
        && request.resource.data.targetRoIds is list
        && request.resource.data.targetRoIds.size() <= 100
        && request.resource.data.createdTaskIds is list
        && request.resource.data.createdTaskIds.size() <= 447
        && request.resource.data.updatedTaskIds is list
        && request.resource.data.updatedTaskIds.size() <= 447
        && request.resource.data.baseRoRevisions is map
        && request.resource.data.baseRoRevisions.size() <= 100
        && request.resource.data.resultRoRevisions is map
        && request.resource.data.resultRoRevisions.size() <= 100
        && request.resource.data.undoSchemaVersion == 1
        && request.resource.data.undoManifestHash is string
        && request.resource.data.undoManifestHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.undoManifestBytes is int
        && request.resource.data.undoManifestBytes >= 1
        && request.resource.data.undoManifestBytes <= 614400
        && request.resource.data.undoItemCount is int
        && request.resource.data.undoItemCount >= 1
        && request.resource.data.undoItemCount <= 447
        && request.resource.data.writeCount == request.resource.data.undoItemCount + 3
        && request.resource.data.undoItemCount
          == request.resource.data.targetRoIds.size()
            + request.resource.data.createdTaskIds.size()
            + request.resource.data.updatedTaskIds.size()
        && request.resource.data.baseRoRevisions.size() == request.resource.data.targetRoIds.size()
        && request.resource.data.resultRoRevisions.size() == request.resource.data.targetRoIds.size()
        && existsAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)/undoData/manifest)
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)/undoData/manifest).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)/undoData/manifest).data.operationId == operationId
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)/undoData/manifest).data.payloadHash == request.resource.data.undoManifestHash
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)/undoData/manifest).data.payloadBytes == request.resource.data.undoManifestBytes
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)/undoData/manifest).data.itemCount == request.resource.data.undoItemCount
        && existsAfter(/databases/$(database)/documents/gibUndoHeads/$(uid)/surfaces/$(request.resource.data.surfaceId))
        && getAfter(/databases/$(database)/documents/gibUndoHeads/$(uid)/surfaces/$(request.resource.data.surfaceId)).data.operationId == operationId
        && getAfter(/databases/$(database)/documents/gibUndoHeads/$(uid)/surfaces/$(request.resource.data.surfaceId)).data.manifestHash == request.resource.data.undoManifestHash
        && getAfter(/databases/$(database)/documents/gibUndoHeads/$(uid)/surfaces/$(request.resource.data.surfaceId)).data.itemCount == request.resource.data.undoItemCount
        && request.resource.data.committedAt == request.time;
      allow update, delete: if false;

      match /undoData/{manifestId} {
        allow get: if isAuth() && (request.auth.uid == uid || isManager());
        allow list: if false;
        allow create: if isAuth()
          && request.auth.uid == uid
          && manifestId == 'manifest'
          && request.resource.data.keys().hasAll([
            'kind', 'operationId', 'ownerUid', 'schemaVersion', 'payload',
            'payloadHash', 'payloadBytes', 'itemCount', 'committedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'kind', 'operationId', 'ownerUid', 'schemaVersion', 'payload',
            'payloadHash', 'payloadBytes', 'itemCount', 'committedAt'
          ])
          && request.resource.data.kind == 'gib_undo_manifest'
          && request.resource.data.operationId == operationId
          && request.resource.data.ownerUid == uid
          && request.resource.data.schemaVersion == 1
          && request.resource.data.payload is bytes
          && request.resource.data.payload.size() >= 1
          && request.resource.data.payload.size() <= 614400
          && request.resource.data.payloadHash is string
          && request.resource.data.payloadHash.matches('^[0-9a-f]{64}$')
          && request.resource.data.payloadBytes == request.resource.data.payload.size()
          && request.resource.data.itemCount is int
          && request.resource.data.itemCount >= 1
          && request.resource.data.itemCount <= 447
          && existsAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId))
          && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)).data.undoManifestHash == request.resource.data.payloadHash
          && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)).data.undoManifestBytes == request.resource.data.payloadBytes
          && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)).data.undoItemCount == request.resource.data.itemCount
          && request.resource.data.committedAt == request.time;
        allow update, delete: if false;
      }

      match /undoReceipts/{receiptId} {
        allow get: if isAuth() && (request.auth.uid == uid || isManager());
        allow list: if false;
        allow create: if isAuth()
          && request.auth.uid == uid
          && receiptId == 'undo_v1'
          && request.resource.data.keys().hasAll([
            'kind', 'operationId', 'ownerUid', 'manifestHash', 'itemCount',
            'createdTaskIds', 'surfaceId', 'committedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'kind', 'operationId', 'ownerUid', 'manifestHash', 'itemCount',
            'createdTaskIds', 'surfaceId', 'committedAt'
          ])
          && request.resource.data.kind == 'gib_undo'
          && request.resource.data.operationId == operationId
          && request.resource.data.ownerUid == uid
          && request.resource.data.manifestHash
            == get(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)).data.undoManifestHash
          && request.resource.data.itemCount
            == get(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)).data.undoItemCount
          && request.resource.data.createdTaskIds
            == get(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)).data.createdTaskIds
          && request.resource.data.surfaceId
            == get(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(operationId)).data.surfaceId
          && canCommitGibUndoReceipt(uid, operationId)
          && request.resource.data.committedAt == request.time;
        allow update, delete: if false;
      }
    }

    // One mutable pointer per owner/page surface. It is discovery-only; every
    // Undo still validates the immutable operation and manifest.
    match /gibUndoHeads/{uid}/surfaces/{surfaceId} {
      allow get: if isAuth() && (request.auth.uid == uid || isManager());
      allow list: if false;
      allow create, update: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'kind', 'ownerUid', 'surface', 'surfaceId', 'operationId',
          'manifestHash', 'itemCount', 'committedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'kind', 'ownerUid', 'surface', 'surfaceId', 'operationId',
          'manifestHash', 'itemCount', 'committedAt'
        ])
        && request.resource.data.kind == 'gib_undo_head'
        && request.resource.data.ownerUid == uid
        && request.resource.data.surface is string
        && request.resource.data.surface.size() >= 1
        && request.resource.data.surface.size() <= 160
        && request.resource.data.surfaceId == surfaceId
        && request.resource.data.surfaceId.matches('^surface_[0-9a-f]{64}$')
        && request.resource.data.operationId is string
        && request.resource.data.operationId.size() >= 30
        && request.resource.data.operationId.size() <= 120
        && request.resource.data.manifestHash is string
        && request.resource.data.manifestHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 1
        && request.resource.data.itemCount <= 447
        && existsAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(request.resource.data.operationId))
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(request.resource.data.operationId)).data.surface == request.resource.data.surface
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(request.resource.data.operationId)).data.surfaceId == surfaceId
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(request.resource.data.operationId)).data.undoManifestHash == request.resource.data.manifestHash
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(request.resource.data.operationId)).data.undoItemCount == request.resource.data.itemCount
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(request.resource.data.operationId)).data.committedAt == request.time
        && request.resource.data.committedAt == request.time;
      allow delete: if isAuth()
        && request.auth.uid == uid
        && existsAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(resource.data.operationId)/undoReceipts/undo_v1)
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(resource.data.operationId)/undoReceipts/undo_v1).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(resource.data.operationId)/undoReceipts/undo_v1).data.surfaceId == surfaceId
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(resource.data.operationId)/undoReceipts/undo_v1).data.manifestHash == resource.data.manifestHash
        && getAfter(/databases/$(database)/documents/gibOperations/$(uid)/operations/$(resource.data.operationId)/undoReceipts/undo_v1).data.committedAt == request.time;
    }

    // ── Chat conversations ────────────────────────────────────────────────────
    match /conversations/{convoId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;
      allow update: if isAuth() && request.auth.uid in resource.data.members && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastAt', 'lastSenderId', 'lastSenderName'])
          && request.resource.data.lastSenderId == request.auth.uid
        )
      );
      allow delete: if isAuth() && isManager();

      match /messages/{messageId} {
        allow read: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.members;
        allow create: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.members
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Settings (AI key, mappings) ───────────────────────────────────────────
    match /settings/{docId} {
      // All employees can read settings (needed for AI key access)
      // Only managers can write settings
      allow read: if isAuth();
      allow write: if isAuth() && isManager();
    }
  }
}
